{
  config,
  pkgs,
  lib,
  ...
}:
let
  Helpers = config.helpers;
  brewPrefix = config.homebrew.prefix;
in
builtins.seq [ pkgs lib ] {
  ### Homebrew setup.
  homebrew = {
    enable = true;

    # Use Brewfile in /nix/store that is generated by configuration.nix when invoking brew bundle command
    global = {
      brewfile = true;
      autoUpdate = false;
    };

    # Upgrade casks in homebrew.casks
    greedyCasks = true;

    ### Setup for updates via Nix
    onActivation = {
      upgrade = true;
      autoUpdate = true;
      ## The following allows Nix to uninstall stuff absent from cask list
      #   cleanup switch no longer supported
      # cleanup = "zap";
      # extraFlags = [ "--force-cleanup" ];
    };
    ### End Setup for updates via Nix

    brews = [
      "exercism"
      "mole"
    ];

    casks = [
      {
        name = "whatsapp";
        greedy = true;
      }
      {
        name = "signal";
        greedy = true;
        postinstall = Helpers.restartApp "Signal";
      }
      {
        name = "keet";
        greedy = true;
      }
      {
        name = "google-drive";
        greedy = true;
      }
      {
        name = "google-chrome";
        greedy = true;
        postinstall = Helpers.restartApp "Google Chrome";
      }
      {
        name = "brave-browser";
        greedy = true;
        postinstall = Helpers.restartApp "Brave Browser";
      }
      {
        name = "proton-drive";
        greedy = true;
        postinstall = Helpers.restartApp "Proton Drive";
      }
      {
        name = "proton-meet";
        greedy = true;
      }
      {
        name = "logos";
        greedy = true;
      }
      {
        name = "microsoft-office";
        greedy = true;
      }
      {
        name = "zoom";
        greedy = true;
      }
      {
        name = "affinity";
        greedy = true;
      }
      {
        name = "handbrake-app";
        greedy = true;
        postinstall = ''
          /usr/bin/xattr -dr com.apple.quarantine \"${brewPrefix}/Caskroom/handbrake-app\" 2>/dev/null || true
        '';
      }
      {
        name = "yubico-authenticator";
        greedy = true;
      }
    ];
  };
}
