#!/usr/bin/env zsh

set -u
set -o pipefail

readonly ESC="$(tput sgr0)"
readonly BOLD="$(tput bold)"
readonly GREEN="$(tput setaf 2)"
readonly RED="$(tput setaf 1)"

function cleanup() {
    printf "${ESC}"
}

trap cleanup EXIT INT TERM QUIT

get_atominfo() {
    curl -sL --connect-timeout 20 \
        --retry 3 \
        --retry-delay 10 \
        --retry-connrefused \
        "$1" | awk '/<entry>/{flag=1} flag && /<id>/{print; exit}' | sed -E 's/.*Commit\///' | sed -e 's/<[^>]*>//g' | xargs
}

SCRIPTNAME=$(readlink -f "$0")
SCRIPTDIR=$(dirname "$SCRIPTNAME")

## Store the remote hash of each channel
typeset -A RHASH

printf "${BOLD}${GREEN}Updating nix-darwin...${ESC}\n"
UPDCHAN=$(sudo -H nix-channel --list)
if [[ ! -n "$UPDCHAN" ]]; then
    printf "${BOLD}${RED}!!!!!!Unable to get any root nix channels${ESC}\n"
    exit 1
fi

printf "${BOLD}${GREEN}====== Starting to update root channels ======\n"
while read -r name url; do
    # Skip empty lines or lines missing a name
    [[ -z "$url" || -z "$name" ]] && continue
    printf "--- $name $url\n"

    # Compute the remote feed
    if [[ "$url" =~ "github\.com" ]]; then
        # Clean URL and strip tracking prefixes/extensions
        CLEAN_PATH=$(echo "$url" | sed -E 's|https://github.com/||' | sed 's|/archive/|/|')

        OWNER=$(echo "$CLEAN_PATH" | cut -d'/' -f1)
        REPO=$(echo "$CLEAN_PATH" | cut -d'/' -f2)

        # Strip trailing package extensions (.tar.gz or .zip) from the branch segment
        BRANCH=$(echo "$CLEAN_PATH" | cut -d'/' -f3 | sed -E 's/\.(tar\.gz|zip)//')

        FEED_URL="https://github.com/${OWNER}/${REPO}/commits/${BRANCH}.atom"
    elif [[ "$url" =~ "nixos\.org" ]]; then
        # This regex isolates the trailing identifier (e.g., nixpkgs-unstable) regardless of the domain prefix
        CHANNEL_NAME=$(echo "$url" | sed -E 's|https://(channels\.)?nixos\.org(/channels)?/||' | sed 's|/||g')

        FEED_URL="https://github.com/NixOS/nixpkgs/commits/${CHANNEL_NAME}.atom"
    else
        printf "${BOLD}${RED}Channel $name: Unknown channel format - cannot derive feed${ESC}\n"
        RHASH[$name]=""
        continue
    fi

    # Get the remote hash of the channel
    RHASH[$name]=$(get_atominfo "$FEED_URL")

    if [[ "$name" == "nixpkgs" ]]; then
        # Alternate method to get latest commit hash of nixpkgs channel
        RHASH[$name]=$(curl -LIs -o /dev/null -w %{url_effective} $url | sed -e 's/.*\.//')
    fi

done <<< "$UPDCHAN"

# Check that nixpkgs hash is present
if [[ ! -v "RHASH[nixpkgs]" ]]; then
    printf "${BOLD}${RED}!!!!!!Unable to get remote commit hash of nixpkgs channel${ESC}\n"
    exit 1
fi


printf "${BOLD}${RED}"
sudo -H nix-channel --update --verbose 2>&1 | tail -n +2
printf "${BOLD}${GREEN}====== Completed updating root channels ======${ESC}\n\n\n"
sleep 3

UPDCHAN=$(nix-channel --list)
if [[ -n "$UPDCHAN" ]]; then
    printf "${BOLD}${GREEN}====== Starting to update user channels ======\n"
    while read -r name url; do
        # Skip empty lines or lines missing a name
        [[ -z "$url" || -z "$name" ]] && continue
        printf "--- $name $url\n"
    done <<< "$UPDCHAN"
    printf "${BOLD}${RED}"
    nix-channel --update --verbose 2>&1 | tail -n +2
    printf "${BOLD}${GREEN}====== Completed updating user channels ======${ESC}\n\n\n"
    sleep 3
fi

WORKFILE=~/.working-nixpkgs
NONWORKFILE=~/.nonworking-nixpkgs
[[ -f $WORKFILE ]] || touch $WORKFILE
[[ -f $NONWORKFILE ]] || touch $NONWORKFILE
LAST_GOOD_REV=$(awk 'END {print $1}' $WORKFILE || echo 0)
LATEST_NIXPKGS_REV=${RHASH[nixpkgs]}
BUILDARGS=""
BUILDREV="$LATEST_NIXPKGS_REV"
if grep -q "^$LATEST_NIXPKGS_REV" $NONWORKFILE; then
    if [[ "$LAST_GOOD_REV" == "0" ]]; then
        OPTIONS="[l/x]"
    else
        OPTIONS="[l/g/x]"
    fi
    echo "nixpkgs rev $LATEST_NIXPKGS_REV failed to build previously"
    echo "What would you like to build? $OPTIONS"
    echo " l/L - Latest nixpkgs rev"
    if [[ "$LAST_GOOD_REV" != "0" ]]; then
        echo " g/G - Last good rev"
    fi
    echo " x/X - Exit"
    echo -n "$OPTIONS "
    read -k 1 i
    case "$i" in
        l|L)
            ;;
        g|G)
            if [[ "$LAST_GOOD_REV" == "0" ]]; then
                exit 0
            fi
            BUILDARGS="-I nixpkgs=https://github.com/NixOS/nixpkgs/archive/${LAST_GOOD_REV}.tar.gz"
            BUILDREV="$LAST_GOOD_REV"
            ;;
        *)
            exit 0
            ;;
    esac
fi

printf "${BOLD}${GREEN}====== Starting to rebuild system ========${ESC}\n"

## Generate the primary user nix file
$SCRIPTDIR/genusernix.sh

sudo -H darwin-rebuild switch --verbose $(echo $BUILDARGS)
BUILDRESULT=$?

# Create a secure temporary file
TMPFILE=$(mktemp) || exit 1

# Ensure temporary file is cleaned up if script exits early
trap 'rm -f "$TMPFILE"' EXIT

if [[ "$BUILDRESULT" == "0" ]]; then
    if grep -q "^$BUILDREV" $WORKFILE ; then
        sed -i "/^$BUILDREV.*$/c$BUILDREV : $(date +"%d %b %Y %I:%M:%S %p")" $WORKFILE
    else
        echo "$BUILDREV : $(date +"%d %b %Y %I:%M:%S %p")" >> $WORKFILE
    fi
    if [[ "$(wc -l < $WORKFILE | xargs)" -gt 40 ]]; then
        if tail -n 20 $WORKFILE > "$TMPFILE"; then
            mv "$TMPFILE" "$WORKFILE"
        fi
    fi
    sed -i "/^$BUILDREV/d" $NONWORKFILE

    HASHDIR=~/.cache/nixchannels_hash
    mkdir -p $HASHDIR
    for channame in "${(k)RHASH[@]}"; do
        # 0. Do not store nixpkgs commit hash
        if [[ "$channame" == "nixpkgs" ]]; then
            continue
        fi

        # 1. Read the existing commit hash if it exists
        hashfile=$HASHDIR/${channame}_hash
        LOCAL_HASH=""
        if [[ -f "$hashfile" ]]; then
            LOCAL_HASH=$(cat "$hashfile")
        fi

        # 2. Get the remote hash from the channel feed
        REMOTE_HASH=${RHASH[$channame]}

        # 3. Save the hash if present
        if [[ -n "$REMOTE_HASH" ]]; then
            if [[ "$LOCAL_HASH" != "$REMOTE_HASH" ]]; then
                echo "$REMOTE_HASH" | tee "$hashfile" > /dev/null
                printf "${BOLD}${RED}Updated commit hash for $channame${ESC}\n"
            fi
        else
            printf "${BOLD}${RED}Could not get commit hash for $channame${ESC}\n"
        fi
    done

else
    if grep -q "^$BUILDREV" $NONWORKFILE ; then
        sed -i "/^$BUILDREV.*$/c$BUILDREV : $(date +"%d %b %Y %I:%M:%S %p")" $NONWORKFILE
    else
        echo "$BUILDREV : $(date +"%d %b %Y %I:%M:%S %p")" >> $NONWORKFILE
    fi
    if [[ "$(wc -l < $NONWORKFILE | xargs)" -gt 40 ]]; then
        if tail -n 20 $NONWORKFILE > "$TMPFILE"; then
            mv "$TMPFILE" "$NONWORKFILE"
        fi
    fi
fi

printf "\n${BOLD}${GREEN}====== Checking permissions of terminal programs ======${ESC}\n"
$SCRIPTDIR/nixpkgs/launchdagents/checktermperms.sh

printf "${BOLD}${GREEN}Completed rebuilding system${ESC}\n"

